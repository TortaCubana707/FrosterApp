<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/fondo_normal"
    android:fillViewport="true"
    tools:context=".ui.AjustesActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="18dp">

        <!-- Broker MQTT: la direccion ya no esta escrita en el codigo -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/titulo_broker"
            android:textColor="@color/texto"
            android:textSize="17sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="@string/ayuda_broker"
            android:textColor="@color/texto_tenue"
            android:textSize="13sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="horizontal">

            <EditText
                android:id="@+id/campoBrokerHost"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="3"
                android:autofillHints=""
                android:hint="@string/hint_broker_host"
                android:importantForAutofill="no"
                android:inputType="textUri"
                android:textColor="@color/texto"
                android:textColorHint="@color/texto_tenue" />

            <EditText
                android:id="@+id/campoBrokerPuerto"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:autofillHints=""
                android:hint="@string/hint_broker_puerto"
                android:importantForAutofill="no"
                android:inputType="number"
                android:maxLength="5"
                android:textColor="@color/texto"
                android:textColorHint="@color/texto_tenue" />
        </LinearLayout>

        <!-- Aqui aparece el motivo si la direccion no sirve (p. ej. localhost) -->
        <TextView
            android:id="@+id/errorBroker"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/alerta_texto"
            android:textSize="13sp"
            android:visibility="gone" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="16dp"
            android:background="@color/linea" />

        <!-- Umbral de luz -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/titulo_umbral_luz"
            android:textColor="@color/texto"
            android:textSize="17sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="@string/ayuda_umbral_luz"
            android:textColor="@color/texto_tenue"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/etiquetaLuz"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:gravity="center"
            android:textColor="@color/texto"
            android:textSize="30sp"
            android:textStyle="bold"
            tools:text="40 %" />

        <SeekBar
            android:id="@+id/deslizadorLuz"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:max="100" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="20dp"
            android:layout_marginBottom="20dp"
            android:background="@color/linea" />

        <!-- Umbral de temperatura -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/titulo_umbral_temp"
            android:textColor="@color/texto"
            android:textSize="17sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="@string/ayuda_umbral_temp"
            android:textColor="@color/texto_tenue"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/etiquetaTemp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:gravity="center"
            android:textColor="@color/texto"
            android:textSize="30sp"
            android:textStyle="bold"
            tools:text="27.0 °C" />

        <!-- 51 posiciones: de 15.0 a 40.0 grados en pasos de medio grado -->
        <SeekBar
            android:id="@+id/deslizadorTemp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:max="50" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="20dp"
            android:layout_marginBottom="14dp"
            android:background="@color/linea" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_gravity="center_vertical"
                android:layout_weight="1"
                android:text="@string/titulo_alertas"
                android:textColor="@color/texto"
                android:textSize="16sp" />

            <androidx.appcompat.widget.SwitchCompat
                android:id="@+id/interruptorAlertas"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />
        </LinearLayout>

        <Button
            android:id="@+id/botonGuardar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="26dp"
            android:text="@string/boton_guardar" />

        <Button
            android:id="@+id/botonRestablecer"
            style="?attr/borderlessButtonStyle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/boton_restablecer"
            android:textColor="@color/texto_tenue" />
    </LinearLayout>
</ScrollView>
