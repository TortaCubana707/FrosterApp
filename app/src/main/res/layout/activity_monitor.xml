<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/raiz"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/fondo_normal"
    android:fillViewport="true"
    tools:context=".ui.MonitorActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/titulo_principal"
            android:textColor="@color/texto"
            android:textSize="20sp"
            android:textStyle="bold" />

        <!-- Prueba de red: a qué broker está conectada la app y qué IP tiene el
             teléfono. Si aquí apareciera localhost, la app no estaría en Wi-Fi. -->
        <TextView
            android:id="@+id/textoConexion"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:textColor="@color/texto_tenue"
            android:textSize="13sp"
            android:textStyle="bold"
            tools:text="MQTT conectado a tcp://192.168.150.215:1883" />

        <TextView
            android:id="@+id/textoIpTelefono"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/texto_tenue"
            android:textSize="13sp"
            tools:text="Este teléfono: 192.168.150.37" />

        <TextView
            android:id="@+id/textoNodo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:textColor="@color/texto_tenue"
            android:textSize="13sp"
            tools:text="esp32_01 · paquete #12" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/textoMarcaTiempo"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textColor="@color/texto_tenue"
                android:textSize="13sp"
                tools:text="2026-09-02T10:32:05Z" />

            <TextView
                android:id="@+id/textoRssi"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/texto_tenue"
                android:textSize="13sp"
                tools:text="RSSI -58 dBm" />
        </LinearLayout>

        <!-- Banner que cambia de texto y de color segun el nivel de alerta -->
        <TextView
            android:id="@+id/bannerAlerta"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:background="@color/fondo_normal"
            android:gravity="center"
            android:padding="14dp"
            android:textColor="@color/texto"
            android:textSize="16sp"
            android:textStyle="bold"
            tools:text="Todo en rango" />

        <!-- Sensores -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="6dp"
                android:layout_weight="1"
                android:background="@color/tarjeta"
                android:orientation="vertical"
                android:padding="14dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/etq_luz"
                    android:textColor="@color/texto_tenue"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/valorLuz"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/texto"
                    android:textSize="26sp"
                    android:textStyle="bold"
                    tools:text="85 %" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                android:background="@color/tarjeta"
                android:orientation="vertical"
                android:padding="14dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/etq_temp"
                    android:textColor="@color/texto_tenue"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/valorTemp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/texto"
                    android:textSize="26sp"
                    android:textStyle="bold"
                    tools:text="24.5 °C" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="6dp"
                android:layout_weight="1"
                android:background="@color/tarjeta"
                android:orientation="vertical"
                android:padding="14dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/etq_humedad"
                    android:textColor="@color/texto_tenue"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/valorHumedad"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/texto"
                    android:textSize="22sp"
                    tools:text="48.2 %" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                android:background="@color/tarjeta"
                android:orientation="vertical"
                android:padding="14dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/etq_rocio"
                    android:textColor="@color/texto_tenue"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/valorRocio"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/texto"
                    android:textSize="22sp"
                    tools:text="12.9 °C" />
            </LinearLayout>
        </LinearLayout>

        <!-- Actuadores -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@color/tarjeta"
            android:orientation="vertical"
            android:padding="14dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/etq_actuadores"
                android:textColor="@color/texto_tenue"
                android:textSize="12sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/etq_led"
                    android:textColor="@color/texto_tenue"
                    android:textSize="14sp" />

                <TextView
                    android:id="@+id/valorLed"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/texto"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    tools:text="ON" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/etq_ventilador"
                    android:textColor="@color/texto_tenue"
                    android:textSize="14sp" />

                <TextView
                    android:id="@+id/valorVentilador"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/texto"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    tools:text="62 %" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/etq_peltier"
                    android:textColor="@color/texto_tenue"
                    android:textSize="14sp" />

                <TextView
                    android:id="@+id/valorPeltier"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/texto"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    tools:text="OFF" />
            </LinearLayout>
        </LinearLayout>

        <!-- Umbrales recuperados de DataStore -->
        <TextView
            android:id="@+id/textoUmbrales"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:textColor="@color/texto_tenue"
            android:textSize="13sp"
            tools:text="Umbrales guardados: luz &lt; 40 % · temp &gt; 27.0 °C" />

        <Button
            android:id="@+id/botonAjustes"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/boton_ajustes" />

        <Button
            android:id="@+id/botonHistorial"
            style="?attr/borderlessButtonStyle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/boton_historial"
            android:textColor="@color/texto" />
    </LinearLayout>
</ScrollView>
